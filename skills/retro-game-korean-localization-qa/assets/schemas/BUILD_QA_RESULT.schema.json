{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Machine-readable Build QA result v1.5",
  "type":"object",
  "additionalProperties":false,
  "required":["project","source_id","stages","build_fail_codes","build_issues","release_state"],
  "properties":{
    "project":{"type":"string"},
    "build_id":{"type":"string"},
    "source_id":{"type":"string"},
    "source_sha256":{"type":["string","null"],"pattern":"^[0-9a-fA-F]{64}$"},
    "source_size":{"type":["integer","null"],"minimum":0},
    "source_format":{"type":["string","null"]},
    "baseline_id":{"type":["string","null"]},
    "baseline_sha256":{"type":["string","null"],"pattern":"^[0-9a-fA-F]{64}$"},
    "output_id":{"type":["string","null"]},
    "output_sha256":{"type":["string","null"],"pattern":"^[0-9a-fA-F]{64}$"},
    "output_size":{"type":["integer","null"],"minimum":0},
    "stages":{"type":"object","additionalProperties":false,"required":["SOURCE_QA","STATIC_BINARY_QA","RC_BUILD","RC_READBACK_QA","RUNTIME_SMOKE","CANONICAL_PROMOTION","PATCH_PACKAGE","RELEASE"],"properties":{"SOURCE_QA":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"STATIC_BINARY_QA":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"RC_BUILD":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"RC_READBACK_QA":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"RUNTIME_SMOKE":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"CANONICAL_PROMOTION":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"PATCH_PACKAGE":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]},"RELEASE":{"enum":["PASS","FAIL","PENDING","NOT_RUN","BLOCKED"]}}},
    "build_fail_codes":{"type":"array","items":{"type":"string"}},
    "build_warnings":{"type":"array","items":{"type":"string"}},
    "protected_region_status":{"type":["string","null"]},
    "missing_glyphs":{"type":["integer","null"],"minimum":0},
    "overflow_count":{"type":["integer","null"],"minimum":0},
    "pointer_offset_size_mismatch_count":{"type":["integer","null"],"minimum":0},
    "physical_overlap_count":{"type":["integer","null"],"minimum":0},
    "physical_out_of_range_count":{"type":["integer","null"],"minimum":0},
    "lkg_id":{"type":["string","null"]},
    "fkb_id":{"type":["string","null"]},
    "runtime_test_path":{"type":["string","null"]},
    "release_state":{"enum":["READY_FOR_STATIC_REVIEW","READY_FOR_RUNTIME","CANONICAL","READY_FOR_RELEASE","BLOCKED","PENDING"]},
    "build_issues":{"type":"array","items":{"type":"string"}}
  }
}
