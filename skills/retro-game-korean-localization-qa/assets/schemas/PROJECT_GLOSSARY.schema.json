{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PROJECT_GLOSSARY v1.0",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_text","target_text","term_source","scope","locked"],
    "properties": {
      "source_text": {"type":"string","minLength":1},
      "target_text": {"type":"string","minLength":1},
      "term_source": {"const":"PROJECT_GLOSSARY"},
      "scope": {"type":"string","enum":["ALL","UI","DIALOGUE","ITEM","SYSTEM","DESCRIPTION"]},
      "note": {"type":"string"},
      "locked": {"type":"boolean"},
      "last_updated": {"type":"string","format":"date"}
    }
  }
}
